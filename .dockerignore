!data/geografica/municipios_dane_2025_plotly.geojson

# -----------------------------------------------------------------------------
# Volver a excluir artefactos locales dentro de lo permitido
# -----------------------------------------------------------------------------

# Resultados de build.sh y tox en la máquina local: el wheel se construye
# de cero dentro de la imagen
model-package/.tox/
model-package/dist/
model-package/build/
model-package/**/*.egg-info
model-package/agropredict_model/trained_models/*.skops
model-package/agropredict_model/trained_models/*.json

# Archivos temporales, caché y respaldos
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/*.bak