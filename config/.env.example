# Copiar este archivo como config/.env (el .env NO se sube a Git)

# Opción A: servidor MLflow compartido del equipo en AWS EC2.
# Pedir la IP al equipo; cambia cada vez que se reinicia la instancia.
# MLFLOW_TRACKING_URI=http://IP_DE_LA_EC2:5000

# Opción B: servidor MLflow local
MLFLOW_TRACKING_URI=http://localhost:5000

MLFLOW_EXPERIMENT=agropredict-maiz-rendimiento
